# Kept in the project, but never uploaded to Vercel.
#
# Every path here is anchored with a leading slash so it matches ONLY at the
# repo root. Without it, "supabase/" would also match src/lib/supabase/ - the
# Supabase clients the whole app imports - and the build fails with
# "Can't resolve '@/lib/supabase/server'".

# Database schema and one-off maintenance SQL. Applied through the Supabase
# dashboard by hand, never by the app at runtime.
/supabase/

# Verification suites and the demo seeder. Local tooling only.
/scripts/

# Notes for coding agents.
/AGENTS.md
/CLAUDE.md

# Build output and logs - Vercel builds its own.
/.next/
*.log
*.tsbuildinfo
