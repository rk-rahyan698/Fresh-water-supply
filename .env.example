# ---------------------------------------------------------------------------
# Supabase
# Project dashboard -> Settings -> API
# ---------------------------------------------------------------------------

# Your project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Safe to expose to the browser: every request it
# makes is still constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" / secret key. Bypasses RLS entirely.
# SERVER ONLY - never prefix this with NEXT_PUBLIC_ and never commit it.
# Used only for creating auth users from the admin Users screen, and by the
# seed script.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Shown in the header, on receipts and in the browser tab.
NEXT_PUBLIC_BUSINESS_NAME=Water Supply Business

# ---------------------------------------------------------------------------
# Seeding (optional, local/demo only)
# ---------------------------------------------------------------------------

# Password given to the demo accounts by `npm run seed`.
# Leave blank and the script generates one and prints it once.
# Never set this in a production environment.
SEED_PASSWORD=
