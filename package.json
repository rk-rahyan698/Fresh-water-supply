{
  "name": "water",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build:setup": "node scripts/build-setup-sql.mjs",
    "verify:db": "node scripts/verify-db.mjs",
    "verify:migration": "node scripts/verify-migration-0004.mjs",
    "verify:analytics": "node scripts/verify-migration-0006.mjs",
    "verify:reports": "node scripts/verify-migration-0007.mjs",
    "verify:3nf": "node scripts/verify-migration-0008.mjs",
    "verify:totals": "node scripts/verify-migration-0009.mjs",
    "verify:collection": "node scripts/verify-migration-0010.mjs",
    "verify:bybill": "node scripts/verify-migration-0011.mjs",
    "verify:exports": "node scripts/verify-exports.mjs",
    "verify:setup": "node scripts/build-setup-sql.mjs --check",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "verify:all": "npm run verify:db && npm run verify:migration && npm run verify:analytics && npm run verify:reports && npm run verify:3nf && npm run verify:totals && npm run verify:collection && npm run verify:bybill && npm run verify:exports && npm run verify:cleanup && npm run verify:setup",
    "verify:pages": "node --env-file-if-exists=.env.local scripts/verify-pages.mjs",
    "verify:live": "node --env-file-if-exists=.env.local scripts/verify-live.mjs",
    "verify:cleanup": "node scripts/verify-demo-cleanup.mjs",
    "check:deletable": "node --env-file-if-exists=.env.local scripts/check-user-deletable.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
